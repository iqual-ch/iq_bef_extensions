{
  "name": "iqual/iq_bef_extensions",
  "description": "Extensions for Better Exposed Filter module.",
  "type": "drupal-custom-module",
  "repositories": [
    {
      "type": "composer",
      "url": "https://github.com/iqual-ch/iq_bef_extensions"
    }
  ],
  "require": {
    "php": "^8.1",
    "drupal/core": "^10 || ^11",
    "drupal/better_exposed_filters": "^7.0",
    "drupal/vefl": "^3.2",
    "drupal/views_ajax_history": "^1.9",
    "drupal/jquery_ui": "*",
    "drupal/jquery_ui_slider": "*",
    "drupal/jquery_ui_touch_punch": "*",
    "drupal/jquery_ui_datepicker": "*"
  },
  "extra": {
    "patches": {
      "drupal/views_ajax_history": {
        "[https://dgo.to/3107126]: Use Fullscreen Progress Indicator": "https://git.drupalcode.org/project/views_ajax_history/-/merge_requests/24/diffs.diff?diff_id=2678511"
      },
      "drupal/vefl": {
        "[https://dgo.to/3161777]: Compability issue with BEF 7": "https://git.drupalcode.org/project/vefl/-/merge_requests/5/diffs.diff?diff_id=1058177",
        "[https://dgo.to/3188893]: Breaks layout after Drupal 9.1 update": "https://git.drupalcode.org/project/vefl/-/merge_requests/4/diffs.diff?diff_id=1683776"
      }
    }
  }
}
